# NexusChain compliance backend configuration
# Copy to .env and fill in values. All third-party integrations are
# optional — the backend falls back to local/mocked equivalents.

# SQLite database (resolved relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# L1 RPC endpoint. Get the live value from the repo root with:
#   node ../network/resolve-rpc.mjs
RPC_URL=http://127.0.0.1:9654/ext/bc/<blockchain-id>/rpc

# Chain ID of the jurisdiction L1 (0x1869f = 99999)
CHAIN_ID=99999

# Admin key used to write to the TxAllowList precompile (ewoq dev key
# is fine for a local permissioned chain — never use in production)
ADMIN_PRIVATE_KEY=

# Server port (frontend expects 3001 by default)
PORT=3001

# --- Optional integrations ---

# Veriff identity verification. If omitted, sessions are mocked and
# approval can be simulated via POST /api/kyc/webhook.
VERIFF_API_KEY=
VERIFF_API_SECRET=

# Pinata IPFS pinning. If omitted, encrypted documents are stored
# locally in ./ipfs-store/ (AES-256-GCM encrypted either way).
PINATA_JWT=

# Trusted issuer addresses accepted for Verifiable Credential verification
TRUSTED_ISSUERS=
